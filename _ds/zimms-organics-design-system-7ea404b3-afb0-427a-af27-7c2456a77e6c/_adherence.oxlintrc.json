{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "assets/icons/**",
              "assets/illustrations/**",
              "assets/logo/**",
              "components/commerce/**",
              "components/content/**",
              "components/core/**",
              "components/forms/**",
              "components/icons/**",
              "components/layout/**",
              "components/marketing/**",
              "components/navigation/**",
              "slides/zimms/**",
              "ui_kits/storefront/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Novecento Sans Wide|National|Cal Sans|DM Sans))/i]",
        "message": "Font not provided by the design system. Available: Novecento Sans Wide, National, Cal Sans, DM Sans."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccordionItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:question|answer|key|ref|className|style|children)$/]",
        "message": "<AccordionItem> doesn't accept that prop. Declared props: question, answer."
      },
      {
        "selector": "JSXOpeningElement[name.name='Background'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|surface|image|scrim|radius|as|style|key|ref|className|style|children)$/]",
        "message": "<Background> doesn't accept that prop. Declared props: children, surface, image, scrim, radius, as, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Background'] > JSXAttribute[name.name='surface'] > Literal[value!=/^(?:paper|cream|shell|bone|navy|forest|terracotta)$/]",
        "message": "<Background> surface must be one of 'paper' | 'cream' | 'shell' | 'bone' | 'navy' | 'forest' | 'terracotta'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|shape|size|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, shape, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:pill|square)$/]",
        "message": "<Badge> shape must be one of 'pill' | 'square'."
      },
